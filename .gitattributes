# Auto detect text files and perform LF normalization
* text=auto eol=lf

# TypeScript/JavaScript files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# JSON files
*.json text eol=lf

# CSS/SCSS files
*.css text eol=lf
*.scss text eol=lf
# HTML files
*.html text eol=lf
# Documentation
*.md text eol=lf

